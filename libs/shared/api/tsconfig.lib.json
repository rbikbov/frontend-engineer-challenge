{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc/libs/shared/api",
    "types": ["node"],
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["dom", "dom.iterable", "esnext"]
  },
  "exclude": ["**/*.spec.ts", "**/*.test.ts", "**/*.spec.tsx", "**/*.test.tsx"],
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
