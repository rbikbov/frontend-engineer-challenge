# ==============================================================================
# ENVIRONMENT AND RUN MODE
# ==============================================================================
# production | development
NEXT_PUBLIC_ENV=development

# ==============================================================================
# SERVER AND NETWORK SETTINGS (Server Runtime)
# ==============================================================================
# App ports
MAIN_APP_PORT=3000
DASHBOARD_APP_PORT=3001

# Internal URL of the Dashboard zone for Multi-Zones proxying
INTERNAL_DASHBOARD_URL=http://localhost:3001

# ==============================================================================
# BACKEND AND API INTEGRATION (Services & API)
# ==============================================================================
# Auth provider type (AuthApi implementation): graphql
NEXT_PUBLIC_AUTH_BACKEND_TYPE=graphql

# Backend GraphQL API endpoint
NEXT_PUBLIC_AUTH_BACKEND_URL=http://localhost:8080/graphql

# ==============================================================================
# PUBLIC URLS AND NAVIGATION (Routing)
# ==============================================================================
# Main platform domain (entry point)
NEXT_PUBLIC_APP_URL=http://localhost:3000
