{
  "name": "dashboard",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/dashboard",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project dashboard --web",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx next dev -p ${DASHBOARD_APP_PORT:-3001}",
        "cwd": "apps/dashboard",
        "readyWhen": "Ready in"
      }
    },
    "dev-e2e": {
      "executor": "@nx/next:server",
      "options": {
        "buildTarget": "dashboard:build",
        "dev": true,
        "port": 3001
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx next build",
        "cwd": "apps/dashboard"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx next start -p ${DASHBOARD_APP_PORT:-3001}",
        "cwd": "apps/dashboard"
      }
    }
  }
}
