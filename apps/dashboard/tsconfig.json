{
  "extends": "@workspace/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@workspace/ui": ["../../libs/shared/ui/src/index.ts"],
      "@workspace/ui/components/*": ["../../libs/shared/ui/src/components/*"],
      "@workspace/ui/icons/*": ["../../libs/shared/ui/src/icons/*"],
      "@workspace/ui/utils/*": ["../../libs/shared/ui/src/utils/*"],
      "@workspace/api": ["../../libs/shared/api/src/index.ts"],
      "@workspace/constants": ["../../libs/shared/constants/src/index.ts"],
      "@workspace/lib": ["../../libs/shared/lib/src/index.ts"],
      "@app/*": ["./src/app/*"],
      "@pages/*": ["./src/pages/*"],
      "@widgets/*": ["./src/widgets/*"],
      "@features/*": ["./src/features/*"],
      "@entities/*": ["./src/entities/*"],
      "@shared/*": ["./src/shared/*"]
    },
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo"
  },
  "include": [
    "../../apps/dashboard/.next/types/**/*.ts",
    "../../dist/apps/dashboard/.next/types/**/*.ts",
    "next-env.d.ts",
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "node_modules",
    "jest.config.ts",
    "jest.config.cts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    ".next"
  ],
  "references": [
    {
      "path": "../../libs/shared/api"
    },
    {
      "path": "../../libs/shared/ui"
    },
    {
      "path": "../../libs/shared/constants"
    },
    {
      "path": "../../libs/shared/lib"
    }
  ]
}
